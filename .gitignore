# vrek: live SQLite state is rebuilt from .vrek/log.ndjson (vrek_import); only the log is tracked
.vrek/workspace.db
.vrek/workspace.db-*

# machine-local Claude Code settings
.claude/settings.local.json

# build output and dependencies
node_modules/
client/dist/
client/bench/dist/

# client bundle copied in for go:embed by scripts/embed-client; the placeholder is committed
server/internal/clientdist/dist/*
!server/internal/clientdist/dist/.gitkeep

# JetBrains IDE project files
.idea/

# generated fixtures (scripts/gen-fixtures); the manifest is committed
testdata/assets/*
!testdata/assets/manifest.json

# agent worktrees (Claude Code)
.claude/worktrees/

# demo site: generated gallery images (examples/demo-site/gen-images.ts) and the built server
examples/demo-site/img/
bin/
spikes/*/www/sw.js
